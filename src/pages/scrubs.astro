---
import Layout from "../layouts/Layout.astro";
import Card from "../components/Card.astro";
import bradImage from "../assets/scrubs/scrub-brad.png";
import bradTeam from "../assets/team/team-brad.png";
import bradyImage from "../assets/scrubs/scrub-brady.png";
import bradyTeam from "../assets/team/team-brady.png";
import mikeImage from "../assets/scrubs/scrub-mike.png";
import mikeTeam from "../assets/team/team-duran.png";
import calebImage from "../assets/scrubs/scrub-caleb.png";
import calebTeam from "../assets/team/team-caleb.png";
import edImage from "../assets/scrubs/scrub-ed.png";
import edTeam from "../assets/team/team-ed.png";
import kaitImage from "../assets/scrubs/scrub-kait.png";
import kaitTeam from "../assets/team/team-kait.png";
import vinceImage from "../assets/scrubs/scrub-vince.png";
import vinceTeam from "../assets/team/team-vince.png";
import tonyImage from "../assets/scrubs/scrub-tony.png";
import tonyTeam from "../assets/team/team-tony.png";
import mattImage from "../assets/scrubs/scrub-matt.png";
import mattTeam from "../assets/team/team-matt.png";
import mickleImage from "../assets/scrubs/scrub-mickle.png";
import mickleTeam from "../assets/team/team-mickle.png";
import collinImage from "../assets/scrubs/scrub-collin.png";
import collinTeam from "../assets/team/team-collin.jpg";
import stockImage from "../assets/scrubs/scrub-stock.png";
import stockTeam from "../assets/team/team-stock.png";
import chrisImage from "../assets/scrubs/scrub-chris.png";
import chrisTeam from "../assets/team/team-chris.png";
---

<Layout>
  <main class="min-h-screen py-12">
    <section class="max-w-6xl mx-auto px-8 sm:px-6">
      <div
        class="cards-grid grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 xl:grid-cols-4 gap-8 sm:gap-6 sm:justify-items-center justify-content-center mx-auto"
      >
        <Card
          img={bradImage}
          champion="CHAMPION"
          sinceYear="SINCE '13"
          title="KING PENGUINS"
          backImage={bradTeam}
          stats={[
            { label: "SQUEALER", value: "5" },
            { label: "DONG", value: "0" },
          ]}
        />
        <Card
          img={bradyImage}
          sinceYear="SINCE '13"
          title="BLANK SPACE CADETS"
          backImage={bradyTeam}
          stats={[
            { label: "SQUEALER", value: "3" },
            { label: "DONG", value: "1" },
          ]}
        />
        <Card
          img={calebImage}
          sinceYear="SINCE '18"
          title="TD CITY"
          backImage={calebTeam}
          stats={[
            { label: "SQUEALER", value: "1" },
            { label: "DONG", value: "0" },
          ]}
        />
        <Card
          img={chrisImage}
          sinceYear="SINCE '20"
          title="GOBELL OR GO HOME"
          backImage={chrisTeam}
          stats={[
            { label: "SQUEALER", value: "1" },
            { label: "DONG", value: "0" },
          ]}
        />
        <Card
          img={mikeImage}
          sinceYear="SINCE '13"
          title="PRAYING 4 A GREEN CARD"
          backImage={mikeTeam}
          stats={[
            { label: "SQUEALER", value: "1" },
            { label: "DONG", value: "1" },
          ]}
        />
        <Card
          img={tonyImage}
          sinceYear="SINCE '13"
          title="GAME OF CHRONS"
          backImage={tonyTeam}
          stats={[
            { label: "SQUEALER", value: "1" },
            { label: "DONG", value: "3" },
          ]}
        />
        <Card
          img={kaitImage}
          sinceYear="SINCE '13"
          title="HANGIN' BRAIN ON THE BEAN"
          backImage={kaitTeam}
          stats={[
            { label: "SQUEALER", value: "0" },
            { label: "DONG", value: "0" },
          ]}
        />
        <Card
          img={mattImage}
          sinceYear="SINCE '17"
          title="VBALLER? I BARELY KNOW'ER"
          backImage={mattTeam}
          stats={[
            { label: "SQUEALER", value: "0" },
            { label: "DONG", value: "1" },
          ]}
        />
        <Card
          img={stockImage}
          sinceYear="SINCE '19"
          title="MR. MIKEASTONKZ"
          backImage={stockTeam}
          stats={[
            { label: "SQUEALER", value: "0" },
            { label: "DONG", value: "1" },
          ]}
        />
        <Card
          img={collinImage}
          sinceYear="SINCE '26"
          title="COLLINOSCOPIES ARE MY ANTI-DRUG"
          titleSize="compact"
          backImage={collinTeam}
          stats={[
            { label: "SQUEALER", value: "0" },
            { label: "DONG", value: "0" },
          ]}
        />
        <Card
          img={vinceImage}
          sinceYear="SINCE '13"
          title="MIND GOBLINS"
          backImage={vinceTeam}
          stats={[
            { label: "SQUEALER", value: "0" },
            { label: "DONG", value: "1" },
          ]}
        />
        <Card
          img={edImage}
          sinceYear="SINCE '13"
          title="ED ASS"
          backImage={edTeam}
          stats={[
            { label: "SQUEALER", value: "0" },
            { label: "DONG", value: "3" },
          ]}
        />
      </div>
    </section>
    <section class="max-w-6xl mx-auto px-8 sm:px-6 pt-16">
      <h2
        class="flex items-center justify-center gap-3 mb-8 text-sm font-semibold uppercase tracking-[0.35em] text-gray-400"
      >
        <svg
          data-football-icon
          class="h-4 w-4 shrink-0"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          aria-hidden="true"
        >
          <path d="M5.2 18.8c-2-2-2-7.6 3.4-12.3S18.9 1.2 20.8 3.1c1.9 1.9-1 7-5.7 11.7S7.2 20.8 5.2 18.8Z" />
          <path d="m9 8 7 7M10.5 12.5l2-2M12.5 14.5l2-2" />
        </svg>
        <span>In Loving Memory</span>
        <svg
          data-football-icon
          class="h-4 w-4 shrink-0"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          aria-hidden="true"
        >
          <path d="M5.2 18.8c-2-2-2-7.6 3.4-12.3S18.9 1.2 20.8 3.1c1.9 1.9-1 7-5.7 11.7S7.2 20.8 5.2 18.8Z" />
          <path d="m9 8 7 7M10.5 12.5l2-2M12.5 14.5l2-2" />
        </svg>
      </h2>
      <div class="memorial-grid grid grid-cols-1 justify-items-center">
        <Card
          img={mickleImage}
          sinceYear="SINCE '17"
          title="FICKLE MICKLE's LITTLE PICKLE"
          backImage={mickleTeam}
          stats={[
            { label: "SQUEALER", value: "1" },
            { label: "DONG", value: "1" },
          ]}
        />
      </div>
    </section>
  </main>
</Layout>

<style>
  .cards-grid {
    grid-auto-columns: max-content;
    width: fit-content;
    margin-left: auto;
    margin-right: auto;
  }

  @media (min-width: 640px) {
    .cards-grid {
      grid-template-columns: repeat(2, max-content);
    }
  }

  @media (min-width: 768px) {
    .cards-grid {
      grid-template-columns: repeat(3, max-content);
    }
  }

  @media (min-width: 1280px) {
    .cards-grid {
      grid-template-columns: repeat(4, max-content);
    }
  }
</style>
